{
    "name": "nfephp-org/sped-gnre",
    "type": "library",
    "description": "API para geração e comunicação da GNRE com o Portal GNRE (SEFAZ-PE).",
    "keywords": [
        "gnre",
        "sped",
        "nfephp",
        "icms",
        "difal"
    ],
    "homepage": "https://github.com/nfephp-org/sped-gnre",
    "license": [
        "LGPL-3.0-or-later",
        "GPL-3.0-or-later",
        "MIT"
    ],
    "authors": [
        {
            "name": "Matheus Marabesi",
            "email": "matheus.marabesi@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Comunidade NFePHP",
            "homepage": "https://github.com/nfephp-org/sped-gnre/graphs/contributors"
        }
    ],
    "require": {
        "php": ">=7.4",
        "nfephp-org/sped-common": "^5.1",
        "ext-dom": "*",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-soap": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.6",
        "phpstan/phpstan": "^1.10",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "NFePHP\\Gnre\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NFePHP\\Gnre\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "precommit": [
            "@phpcs",
            "@stan",
            "@test"
        ],
        "test": "vendor/bin/phpunit -c phpunit.xml.dist",
        "test-with-coverage": "vendor/bin/phpunit -c phpunit.xml.dist --coverage-clover=coverage.xml",
        "phpcs": "vendor/bin/phpcs",
        "phpcbf": "vendor/bin/phpcbf",
        "stan": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-refactor/v1": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
